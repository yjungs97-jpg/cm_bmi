        function subscribeToDatabase() {
            if (isFirebaseAvailable) {
                // Subscribe to All Profiles
                const profilesQuery = collection(db, 'artifacts', appId, 'public', 'data', 'profiles');
                onSnapshot(profilesQuery, (snapshot) => {
                    allProfiles = {};
                    snapshot.forEach(doc => {
                        allProfiles[doc.id] = doc.data();
                    });
                    renderActiveUsers();
                    renderFeed();
                }, (error) => {
                    console.error("Profiles subscription error:", error);
                });

                // Subscribe to Posts
                const postsQuery = collection(db, 'artifacts', appId, 'public', 'data', 'posts');
                onSnapshot(postsQuery, (snapshot) => {
                    allPosts = [];
                    snapshot.forEach(docSnap => {
                        const post = docSnap.data();
                        post.id = docSnap.id;
                        allPosts.push(post);
                    });
                    // Sort by createdAt desc in memory (Firestore Rule 2: No complex queries)
                    allPosts.sort((a, b) => b.createdAt - a.createdAt);
                    
                    renderFeed();
                    renderMyProfilePage();
                }, (error) => {
                    console.error("Posts subscription error:", error);
                });
            } else {
                // Mock system trigger initial renders
                allProfiles = mockDatabase.profiles;
                allPosts = [...mockDatabase.posts].sort((a, b) => b.createdAt - a.createdAt);
                
                renderActiveUsers();
                renderFeed();
