            counterContainer.textContent = comments.length;
            listContainer.innerHTML = '';

            if (comments.length === 0) {
                listContainer.innerHTML = `
                    <div class="text-center py-10 text-slate-400 space-y-1">
                        <i class="fa-regular fa-comments text-3xl mb-1 text-slate-300 dark:text-slate-800"></i>
                        <p class="text-xs">첫 번째 댓글을 달아 분위기를 띄워보세요!</p>
                    </div>
                `;
                return;
            }

            // Render comments list
            comments.forEach(comment => {
                const cAuthor = allProfiles[comment.userId] || { displayName: comment.displayName || '익명 크루', avatarId: comment.avatarId || 'av1' };
                const cAv = avatars.find(a => a.id === cAuthor.avatarId) || avatars[0];
                const cTimeStr = formatTime(comment.createdAt);

                const commentEl = document.createElement('div');
                commentEl.className = "flex gap-3 items-start p-1.5 hover:bg-slate-50 dark:hover:bg-slate-900/50 rounded-xl transition-colors";
                commentEl.innerHTML = `
                    <div class="w-8 h-8 rounded-full bg-gradient-to-tr ${cAv.bg} flex items-center justify-center text-md flex-shrink-0 shadow-inner">
                        ${cAv.emoji}
                    </div>
                    <div class="flex-1 space-y-0.5">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-bold text-slate-900 dark:text-white">${cAuthor.displayName}</span>
                            <span class="text-[9px] text-slate-400">${cTimeStr}</span>
                        </div>
                        <p class="text-xs text-slate-700 dark:text-slate-300 leading-normal">${comment.text}</p>
                    </div>
                `;
                listContainer.appendChild(commentEl);
            });
            
            // Auto scroll to bottom
            listContainer.scrollTop = listContainer.scrollHeight;
        }

        // Submit Comment
        window.submitComment = async function() {
            const input = document.getElementById('comment-input');
            const text = input.value.trim();
            if (!text || !currentEditingPostId) return;

            const post = allPosts.find(p => p.id === currentEditingPostId);
            if (!post) return;

            if (!post.comments) post.comments = [];

            const newComment = {
                userId: currentUser.uid,
                displayName: userProfileData.displayName,
                avatarId: userProfileData.avatarId,
                text: text,
                createdAt: Date.now()
            };

            post.comments.push(newComment);

            if (isFirebaseAvailable) {
                const postDocRef = doc(db, 'artifacts', appId, 'public', 'data', 'posts', currentEditingPostId);
                await updateDoc(postDocRef, {
                    comments: post.comments
                });
            } else {
                // Mock Update
                const postMock = mockDatabase.posts.find(p => p.id === currentEditingPostId);
                if (postMock) {
                    postMock.comments = post.comments;
                }
                subscribeToDatabase();
            }

            input.value = '';
            renderCommentsList();
            showToast("댓글이 게시되었습니다!", "fa-solid fa-comment-dots text-brand-500");
        };

        // Personal Profile Tab Renderer
        function renderMyProfilePage() {
            if (!userProfileData) return;

            // Fill card data
            const myAv = avatars.find(a => a.id === userProfileData.avatarId) || avatars[0];
            const avatarContainer = document.getElementById('profile-card-avatar');
            avatarContainer.className = `w-20 h-20 rounded-full border-4 border-white/20 bg-gradient-to-tr ${myAv.bg} flex items-center justify-center text-4xl shadow-lg`;
            avatarContainer.innerHTML = myAv.emoji;

            document.getElementById('profile-card-name').textContent = userProfileData.displayName;
            document.getElementById('profile-card-uid').innerHTML = `<i class="fa-solid fa-copy mr-1 text-violet-400"></i> ${currentUser.uid}`;
            document.getElementById('profile-card-uid').setAttribute('onclick', `window.copyUidToClipboard('${currentUser.uid}')`);

            // Calc stats
            const myPosts = allPosts.filter(p => p.userId === currentUser.uid);
            document.getElementById('profile-stat-posts').textContent = myPosts.length;
            
            let totalReceivedLikes = 0;
            myPosts.forEach(p => {
                if (p.likes) totalReceivedLikes += p.likes.length;
            });
            document.getElementById('profile-stat-likes').textContent = totalReceivedLikes;

            // Fill text fields in settings
            document.getElementById('edit-username-input').value = userProfileData.displayName;

            // Render miniature grid of personal posts
            const gridContainer = document.getElementById('my-posts-grid');
            gridContainer.innerHTML = '';

            if (myPosts.length === 0) {
                gridContainer.className = "block text-center py-8 text-xs text-slate-400 border border-dashed border-slate-200 dark:border-slate-800 rounded-xl bg-white dark:bg-slate-900/20";
                gridContainer.textContent = "아직 작성하신 포스트가 없습니다.";
                return;
            } else {
                gridContainer.className = "grid grid-cols-2 gap-2";
            }

            myPosts.forEach(p => {
                const item = document.createElement('div');
                item.className = "aspect-square rounded-xl overflow-hidden relative group cursor-pointer border border-slate-100 dark:border-slate-900";
                item.addEventListener('click', () => {
                    switchView('feed');
                    // Scroll directly to that element if available
                });

                item.innerHTML = `
                    <img src="${p.imageUrl}" class="w-full h-full object-cover" alt="Personal post preview">
                    <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center gap-3 text-white text-xs font-semibold">
                        <span><i class="fa-solid fa-heart mr-1 text-rose-500"></i> ${p.likes ? p.likes.length : 0}</span>
                        <span><i class="fa-solid fa-comment mr-1"></i> ${p.comments ? p.comments.length : 0}</span>
                    </div>
                `;
                gridContainer.appendChild(item);
            });
        }

        // Initialize personal profile preferences editor
        function initProfileEditor() {
            renderAvatarSelector('edit-avatar-grid', userProfileData.avatarId);

            document.getElementById('update-profile-btn').addEventListener('click', async () => {
                const newName = document.getElementById('edit-username-input').value.trim();
                if (!newName) {
                    showToast("이름은 필수로 입력하셔야 합니다!", "fa-solid fa-circle-exclamation text-rose-500");
                    return;
                }

                const updatedProfile = {
                    ...userProfileData,
                    displayName: newName,
                    avatarId: selectedAvatarId,
                    updatedAt: Date.now()
                };

                if (isFirebaseAvailable) {
                    const profileRef = doc(db, 'artifacts', appId, 'public', 'data', 'profiles', currentUser.uid);
                    await updateDoc(profileRef, {
                        displayName: newName,
                        avatarId: selectedAvatarId
                    });
                } else {
                    mockDatabase.profiles[currentUser.uid] = updatedProfile;
                }

                userProfileData = updatedProfile;
                onboardingCompleted();
                showToast("프로필 업데이트가 완료되었습니다!", "fa-solid fa-user-check text-emerald-500");
            });
        }

        // Start App Initializers on load
        window.onload = function() {
            setupApp();
        };

    </script>
</body>
</html>
