<!DOCTYPE html>
<html lang="ko" class="h-full bg-slate-50 dark:bg-slate-900 transition-colors duration-200">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PicFlow - Real-time Photo SNS</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'Noto Sans KR', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#f5f3ff',
                            100: '#ede9fe',
                            500: '#8b5cf6',
                            600: '#7c3aed',
                            700: '#6d28d9',
                        }
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Noto+Sans+KR:wght@300;400;500;700&display=swap" rel="stylesheet">
    
    <style>
        /* Custom scrollbar styling */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: transparent;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 3px;
        }
        .dark ::-webkit-scrollbar-thumb {
            background: #475569;
        }
        /* Custom animations */
        @keyframes pop {
            0% { transform: scale(1); }
            50% { transform: scale(1.3); }
            100% { transform: scale(1); }
        }
        .animate-pop {
            animation: pop 0.3s ease-out;
        }
    </style>
</head>
<body class="h-full text-slate-800 dark:text-slate-100 flex flex-col antialiased">

    <div id="app" class="flex flex-col h-full overflow-hidden max-w-md mx-auto w-full bg-white dark:bg-slate-950 shadow-2xl relative border-x border-slate-100 dark:border-slate-800">
        
        <!-- Welcome / Onboarding / Setup Profile Modal -->
        <div id="onboarding-modal" class="hidden fixed inset-0 z-50 bg-slate-900/80 backdrop-blur-sm flex items-center justify-center p-4">
            <div class="bg-white dark:bg-slate-900 w-full max-w-sm rounded-2xl p-6 shadow-2xl border border-slate-100 dark:border-slate-800">
                <div class="text-center mb-6">
                    <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-gradient-to-tr from-violet-500 to-fuchsia-500 text-white text-2xl mb-3 shadow-lg">
                        <i class="fa-solid fa-camera-retro"></i>
                    </div>
                    <h3 class="text-xl font-bold text-slate-900 dark:text-white">프로필 설정</h3>
                    <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">PicFlow에서 사용할 정보를 입력해 주세요.</p>
                </div>
                
                <div class="space-y-4">
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-2">닉네임</label>
                        <input type="text" id="username-input" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-brand-500 transition-all font-medium" placeholder="닉네임을 입력해 주세요..." maxlength="15">
                    </div>
                    
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-2">아바타 선택</label>
                        <div class="grid grid-cols-4 gap-3" id="avatar-grid">
                            <!-- Populated dynamically with beautiful avatar SVGs or colors -->
                        </div>
                    </div>

                    <button id="save-profile-btn" class="w-full mt-2 bg-gradient-to-r from-violet-600 to-fuchsia-600 hover:from-violet-700 hover:to-fuchsia-700 text-white font-bold py-3 px-4 rounded-xl shadow-lg shadow-violet-500/25 active:scale-95 transition-all flex items-center justify-center gap-2">
                        시작하기 <i class="fa-solid fa-arrow-right"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Custom Notification Toast -->
        <div id="toast" class="fixed top-4 left-1/2 transform -translate-x-1/2 z-50 bg-slate-900/95 dark:bg-slate-800/95 text-white px-4 py-2.5 rounded-xl text-sm font-medium shadow-xl flex items-center gap-2 transition-all duration-300 opacity-0 pointer-events-none scale-90">
            <span id="toast-icon" class="text-brand-500"><i class="fa-solid fa-circle-info"></i></span>
            <span id="toast-msg"></span>
        </div>

        <!-- Main Top Bar -->
        <header class="flex-none px-4 py-3.5 border-b border-slate-100 dark:border-slate-900 flex items-center justify-between bg-white/80 dark:bg-slate-950/80 backdrop-blur-md sticky top-0 z-30">
            <div class="flex items-center gap-2">
                <span class="text-2xl bg-gradient-to-tr from-violet-600 via-fuchsia-500 to-pink-500 bg-clip-text text-transparent font-extrabold tracking-tight">PicFlow</span>
                <span class="px-1.5 py-0.5 text-[9px] font-bold text-violet-600 bg-violet-100 dark:bg-violet-950/50 dark:text-violet-400 rounded-md">LIVE</span>
            </div>
            
            <div class="flex items-center gap-3">
                <button id="theme-toggle" class="w-9 h-9 flex items-center justify-center text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-900 rounded-xl transition-all">
                    <i class="fa-solid fa-moon dark:hidden text-lg"></i>
                    <i class="fa-solid fa-sun hidden dark:block text-lg"></i>
                </button>
                <div class="h-4 w-px bg-slate-200 dark:bg-slate-800"></div>
                <!-- Current Profile Avatar Display -->
                <button id="header-profile-btn" class="flex items-center gap-1.5 hover:opacity-85 transition-opacity">
                    <div id="current-user-avatar" class="w-8 h-8 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center overflow-hidden border border-brand-500/20">
                        <!-- User avatar will go here -->
                    </div>
                </button>
            </div>
        </header>

        <main class="flex-1 overflow-y-auto bg-slate-50/50 dark:bg-slate-950/50 relative">
            
            <!-- VIEW: Feed -->
            <div id="view-feed" class="view-panel space-y-4 py-4 px-4 pb-20">
                <!-- User Status / Online Bar -->
                <div class="bg-white dark:bg-slate-900/60 backdrop-blur rounded-2xl p-3 border border-slate-100 dark:border-slate-900 flex flex-col gap-2">
                    <div class="flex items-center justify-between text-xs font-semibold text-slate-400 uppercase tracking-wide px-1">
                        <span>현재 접속한 멤버들</span>
                        <span id="active-user-count" class="text-brand-500">0명</span>
                    </div>
                    <div id="active-users-list" class="flex items-center gap-3 overflow-x-auto py-1.5 no-scrollbar">
                        <!-- Populated with online users -->
                    </div>
                </div>

                <!-- Feed Content Dynamic Loading Area -->
                <div id="feed-posts-container" class="space-y-4">
                    <!-- Loading Skeleton / Shimmers -->
                    <div id="feed-shimmer" class="space-y-4">
                        <div class="bg-white dark:bg-slate-900 rounded-2xl p-4 space-y-3 animate-pulse">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-full bg-slate-200 dark:bg-slate-800"></div>
                                <div class="space-y-2 flex-1">
                                    <div class="h-4 bg-slate-200 dark:bg-slate-800 rounded w-1/3"></div>
                                    <div class="h-3 bg-slate-200 dark:bg-slate-800 rounded w-1/4"></div>
                                </div>
                            </div>
                            <div class="h-56 bg-slate-200 dark:bg-slate-800 rounded-xl"></div>
                            <div class="h-4 bg-slate-200 dark:bg-slate-800 rounded w-3/4"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- VIEW: Create Post -->
            <div id="view-create" class="view-panel hidden p-4 pb-20 space-y-4">
                <div class="bg-white dark:bg-slate-900 rounded-2xl p-5 border border-slate-100 dark:border-slate-900 space-y-4">
                    <h2 class="text-lg font-bold text-slate-900 dark:text-white">새 포스트 작성</h2>
                    
                    <!-- Tab options for photo selection -->
                    <div class="flex rounded-lg bg-slate-100 dark:bg-slate-800 p-1">
                        <button id="btn-tab-curated" class="flex-1 text-center py-1.5 text-xs font-semibold rounded-md bg-white dark:bg-slate-700 shadow-sm text-slate-800 dark:text-white transition-all">큐레이션 이미지</button>
                        <button id="btn-tab-url" class="flex-1 text-center py-1.5 text-xs font-semibold rounded-md text-slate-500 dark:text-slate-400 transition-all">커스텀 URL</button>
                    </div>

                    <!-- Curated Stock Images selection -->
                    <div id="curated-container" class="space-y-3">
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">마음에 드는 사진 선택</label>
                        <div class="grid grid-cols-3 gap-2" id="curated-stock-grid">
                            <!-- Curated stock options will be rendered here -->
                        </div>
                    </div>

                    <!-- Custom URL input -->
                    <div id="custom-url-container" class="space-y-2 hidden">
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">이미지 주소 (URL)</label>
                        <input type="url" id="custom-image-url" class="w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-brand-500 transition-all" placeholder="https://images.unsplash.com/photo-...">
                    </div>

                    <!-- Image Preview Area -->
                    <div id="image-preview-wrapper" class="aspect-[4/3] rounded-xl overflow-hidden bg-slate-100 dark:bg-slate-950 border border-dashed border-slate-300 dark:border-slate-800 relative flex items-center justify-center">
                        <img id="image-preview" src="" class="w-full h-full object-cover hidden" alt="선택한 이미지 미리보기" onerror="handleImageError(this)">
                        <div id="image-preview-placeholder" class="text-center text-slate-400 p-4">
                            <i class="fa-regular fa-image text-3xl mb-2"></i>
                            <p class="text-xs">상단의 큐레이션 혹은 URL을 통해 이미지를 선택해주세요.</p>
                        </div>
                    </div>

                    <!-- Caption/Description input -->
                    <div class="space-y-2">
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">캡션 (설명)</label>
                        <textarea id="post-caption" rows="3" class="w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-brand-500 transition-all resize-none" placeholder="이 사진에 대한 재미있는 에피소드를 남겨보세요..."></textarea>
                    </div>

                    <button id="publish-post-btn" class="w-full bg-gradient-to-r from-violet-600 to-fuchsia-600 text-white font-bold py-3.5 rounded-xl shadow-lg shadow-violet-500/20 hover:from-violet-700 hover:to-fuchsia-700 transition-all flex items-center justify-center gap-2">
                        <i class="fa-solid fa-paper-plane"></i> 피드에 게시하기
                    </button>
                </div>
            </div>

            <!-- VIEW: My Profile -->
            <div id="view-profile" class="view-panel hidden p-4 pb-20 space-y-4">
                <!-- Main user card -->
                <div class="bg-gradient-to-tr from-slate-900 via-violet-950 to-indigo-950 text-white rounded-3xl p-6 shadow-xl relative overflow-hidden">
                    <div class="absolute -right-10 -bottom-10 w-40 h-40 bg-fuchsia-500/10 rounded-full blur-2xl"></div>
                    <div class="relative z-10 flex flex-col items-center text-center">
                        <div id="profile-card-avatar" class="w-20 h-20 rounded-full border-4 border-white/20 bg-slate-800 overflow-hidden flex items-center justify-center shadow-lg">
                            <!-- Avatar will go here -->
                        </div>
                        <h2 id="profile-card-name" class="text-xl font-bold mt-3">닉네임</h2>
                        <p id="profile-card-uid" class="text-[10px] text-violet-300 font-mono select-all bg-white/10 px-2 py-1 rounded-md mt-1.5 opacity-80 cursor-pointer" title="클릭해서 복사"></p>
                        
                        <!-- Mini Stats Grid -->
                        <div class="grid grid-cols-2 gap-8 w-full mt-6 pt-5 border-t border-white/10">
                            <div>
                                <span class="block text-xs text-violet-200/70 uppercase font-semibold">내 포스트</span>
                                <span id="profile-stat-posts" class="text-xl font-extrabold mt-1 block">0</span>
                            </div>
                            <div>
                                <span class="block text-xs text-violet-200/70 uppercase font-semibold">받은 좋아요</span>
                                <span id="profile-stat-likes" class="text-xl font-extrabold mt-1 block">0</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Personal Profile Settings Editor -->
                <div class="bg-white dark:bg-slate-900 rounded-2xl p-5 border border-slate-100 dark:border-slate-900 space-y-4">
                    <h3 class="text-md font-bold text-slate-900 dark:text-white">프로필 편집</h3>
                    <div class="space-y-3">
                        <div>
                            <label class="block text-xs font-semibold text-slate-500 dark:text-slate-400 mb-1.5">새로운 닉네임</label>
                            <input type="text" id="edit-username-input" class="w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-brand-500 transition-all" placeholder="닉네임 입력">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-500 dark:text-slate-400 mb-1.5">아바타 다시 선택</label>
                            <div class="grid grid-cols-4 gap-3" id="edit-avatar-grid">
                                <!-- Re-used avatar list -->
                            </div>
                        </div>
                        <button id="update-profile-btn" class="w-full bg-slate-900 dark:bg-slate-800 text-white font-bold py-3 rounded-xl hover:bg-slate-800 dark:hover:bg-slate-700 transition-all flex items-center justify-center gap-2">
                            프로필 저장하기
                        </button>
                    </div>
                </div>

                <!-- My Posts list preview -->
                <div class="space-y-2">
                    <h3 class="text-md font-bold text-slate-900 dark:text-white px-1">내가 작성한 포스트</h3>
                    <div id="my-posts-grid" class="grid grid-cols-2 gap-2">
                        <!-- Tiny visual grid items -->
                    </div>
                </div>
            </div>
        </main>

        <!-- Drawer Panel for Post Comments -->
        <div id="comments-drawer" class="hidden absolute inset-0 z-40 bg-slate-900/60 backdrop-blur-xs flex flex-col justify-end">
            <!-- Backdrop Click Area -->
            <div class="flex-1" onclick="closeCommentsDrawer()"></div>
            <!-- Drawer Body -->
            <div class="bg-white dark:bg-slate-950 rounded-t-[2.5rem] border-t border-slate-100 dark:border-slate-900 max-h-[75%] flex flex-col shadow-2xl animate-slide-up relative">
                <!-- Decorative Notch -->
                <div class="w-12 h-1.5 bg-slate-200 dark:bg-slate-800 rounded-full mx-auto my-3 cursor-pointer" onclick="closeCommentsDrawer()"></div>
                
                <div class="px-5 pb-3 flex items-center justify-between border-b border-slate-100 dark:border-slate-900">
                    <h3 class="text-lg font-bold text-slate-900 dark:text-white">댓글 <span id="drawer-comment-count" class="text-brand-500 font-extrabold ml-1">0</span></h3>
                    <button class="w-8 h-8 rounded-full bg-slate-50 dark:bg-slate-900 flex items-center justify-center text-slate-500" onclick="closeCommentsDrawer()">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>

                <!-- Comments List -->
                <div id="drawer-comments-list" class="flex-1 overflow-y-auto p-5 space-y-4">
                    <!-- Dynamic comments list here -->
                </div>

                <!-- New Comment Input Box -->
                <div class="p-4 border-t border-slate-100 dark:border-slate-900 bg-slate-50 dark:bg-slate-950 sticky bottom-0">
                    <form id="comment-form" onsubmit="event.preventDefault(); submitComment();" class="flex items-center gap-2">
                        <input type="text" id="comment-input" class="flex-1 px-4 py-3 text-sm bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-brand-500" placeholder="댓글을 입력해보세요..." maxlength="100">
                        <button type="submit" class="bg-brand-500 text-white px-4 py-3 rounded-xl font-bold hover:bg-brand-600 transition-colors flex items-center justify-center">
                            <i class="fa-solid fa-paper-plane"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Fixed Tab Bottom Navigation Bar -->
        <nav class="flex-none bg-white/90 dark:bg-slate-950/90 backdrop-blur-md border-t border-slate-100 dark:border-slate-900 py-2 px-6 flex items-center justify-between sticky bottom-0 z-30">
            <button id="nav-btn-feed" class="flex flex-col items-center gap-1 group py-1 flex-1 text-brand-500">
                <i class="fa-solid fa-house text-lg group-hover:scale-110 transition-transform"></i>
                <span class="text-[10px] font-bold">홈</span>
            </button>
            
            <button id="nav-btn-create" class="flex flex-col items-center gap-1 group py-1 flex-1 text-slate-400 dark:text-slate-500 hover:text-brand-500 dark:hover:text-brand-400">
                <div class="w-10 h-10 -mt-5 bg-gradient-to-tr from-brand-500 to-fuchsia-500 text-white rounded-full flex items-center justify-center shadow-lg shadow-brand-500/25 group-hover:scale-105 group-hover:rotate-90 transition-all">
                    <i class="fa-solid fa-plus text-lg"></i>
                </div>
            </button>

            <button id="nav-btn-profile" class="flex flex-col items-center gap-1 group py-1 flex-1 text-slate-400 dark:text-slate-500 hover:text-brand-500 dark:hover:text-brand-400">
                <i class="fa-regular fa-user text-lg group-hover:scale-110 transition-transform"></i>
                <span class="text-[10px] font-semibold">내프로필</span>
            </button>
        </nav>

    </div>

    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously, signInWithCustomToken, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, doc, getDoc, setDoc, updateDoc, onSnapshot, collection, query, addDoc, getDocs } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        // Global / Safe Environment Setup
        const appId = typeof __app_id !== 'undefined' ? __app_id : 'picflow-sns-app';
        let firebaseConfigObj = null;
        let db = null;
        let auth = null;
        let isFirebaseAvailable = false;

        // Try parsing Firebase Config safely
        try {
            if (typeof __firebase_config !== 'undefined') {
                firebaseConfigObj = JSON.parse(__firebase_config);
            }
        } catch (e) {
            console.error("Failed to parse Firebase configuration:", e);
        }

        // Active State
        let currentUser = null;
        let userProfileData = null;
        let allPosts = [];
        let allProfiles = {};
        let activeUsers = [];
        let currentEditingPostId = null; // tracking which post comments list is viewing

        // Preset Avatars as SVG Gradients
        const avatars = [
            { id: 'av1', bg: 'from-pink-500 to-rose-500', emoji: '🐱' },
            { id: 'av2', bg: 'from-purple-500 to-indigo-500', emoji: '🦊' },
            { id: 'av3', bg: 'from-amber-400 to-orange-500', emoji: '🐨' },
            { id: 'av4', bg: 'from-teal-400 to-emerald-500', emoji: '🐼' },
            { id: 'av5', bg: 'from-cyan-500 to-blue-600', emoji: '🦄' },
            { id: 'av6', bg: 'from-violet-600 to-fuchsia-600', emoji: '🦊' },
            { id: 'av7', bg: 'from-yellow-400 to-amber-500', emoji: '🐥' },
            { id: 'av8', bg: 'from-emerald-400 to-teal-500', emoji: '🐸' }
        ];

        // Curated Stock Photos (Unsplash URLs to start with, high quality & optimized)
        const stockPhotos = [
            "https://images.unsplash.com/photo-1501854140801-50d01698950b?auto=format&fit=crop&w=600&q=80",
            "https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?auto=format&fit=crop&w=600&q=80",
            "https://images.unsplash.com/photo-1441974231531-c6227db76b6e?auto=format&fit=crop&w=600&q=80",
            "https://images.unsplash.com/photo-1447752875215-b2761acb3c5d?auto=format&fit=crop&w=600&q=80",
            "https://images.unsplash.com/photo-1472214222541-d510753a4707?auto=format&fit=crop&w=600&q=80",
            "https://images.unsplash.com/photo-1525253086316-d0c936c814f8?auto=format&fit=crop&w=600&q=80"
        ];
        let selectedImageUrl = stockPhotos[0];

        // UI Helpers
        function showToast(message, iconClass = "fa-solid fa-circle-info") {
            const toast = document.getElementById('toast');
            const icon = document.getElementById('toast-icon');
            const msg = document.getElementById('toast-msg');
            
            icon.className = iconClass;
            msg.textContent = message;
            
            toast.className = toast.className.replace('opacity-0 pointer-events-none scale-90', 'opacity-100 pointer-events-auto scale-100');
            setTimeout(() => {
                toast.className = toast.className.replace('opacity-100 pointer-events-auto scale-100', 'opacity-0 pointer-events-none scale-90');
            }, 3000);
        }

        // Toggle Dark Mode
        const themeToggleBtn = document.getElementById('theme-toggle');
        themeToggleBtn.addEventListener('click', () => {
            document.documentElement.classList.toggle('dark');
        });

        // Copy Text Function
        window.copyUidToClipboard = function(uidText) {
            const dummy = document.createElement("textarea");
            document.body.appendChild(dummy);
            dummy.value = uidText;
            dummy.select();
            document.execCommand('copy');
            document.body.removeChild(dummy);
            showToast("사용자 ID가 복사되었습니다!", "fa-solid fa-clipboard-check text-emerald-500");
        };

        // Initialize Firebase
        async function setupApp() {
            if (firebaseConfigObj) {
                try {
                    const app = initializeApp(firebaseConfigObj);
                    db = getFirestore(app);
                    auth = getAuth(app);
                    isFirebaseAvailable = true;
                    
                    // Prioritize Custom Token or fallback Anonymously
